{
  "name": "don-turron-semantic",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node dist/server.cjs",
    "build": "npm run build:semantic && node scripts/build-hostinger.cjs",
    "validate:knowledge": "node scripts/dt-semantic/validate.mjs",
    "compile:knowledge": "node scripts/dt-semantic/compile.mjs",
    "validate:artifacts": "node scripts/dt-semantic/verify.mjs",
    "build:semantic": "npm run build:css && npm run validate:knowledge && npm run compile:knowledge && node scripts/dt-semantic/pages.mjs && npm run validate:artifacts",
    "test:observability": "node scripts/dt-semantic/observability.test.mjs",
    "test:nojs": "python tests/qa_semantic_nojs.py",
    "build:css": "node scripts/build-css.mjs",
    "test:inventory": "node tests/qa_inventory_contract.mjs",
    "test:hostinger": "node --test tests/hostinger-server.test.mjs",
    "postinstall": "node scripts/prepare-hostinger.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "mysql2": "^3.24.4",
    "express": "^5.1.0"
  }
}
