    },
    {
      "id": "claim:humidor-viaje-5-puros-description",
      "type": "Claim",
      "name": "Este humidor de viaje guarda hasta cinco puros. Su caja de plástico duradero tiene un humidificador incorporado y un interior acolchado para llevarlos organizados. Los puros y accesorios de ambientación de las fotografías no están incluidos.",
      "status": "supplier_declared"
    },
    {
      "id": "claim:cenicero-mesa-description",
      "type": "Claim",
      "name": "Este set incluye un cenicero portátil de cerámica, una guillotina, un cortador en V y un punzón (punch). Las herramientas de corte tienen componentes de acero inoxidable. El puro de las fotografías se muestra como ejemplo y no está incluido.",
      "status": "supplier_declared"
    },
    {
      "id": "claim:estuche-viaje-description",
      "type": "Claim",
      "name": "Este estuche con cremallera permite llevar hasta seis puros. Incluye un humidificador con esponja para ayudar a conservar la humedad. El proveedor lo describe como impermeable, pero todavía no contamos con una clasificación verificada de resistencia al agua. Los puros de las fotos no están incluidos.",
      "status": "supplier_declared"
    },
    {
      "id": "claim:estuche-kit-viaje-description",
      "type": "Claim",
      "name": "Estuche portátil con acabado negro texturizado y cierre de cremallera. Tiene espacio para llevar entre cuatro y ocho puros, según su tamaño, y organizar accesorios. Los elementos de las fotografías son ilustrativos; aún falta confirmar cuáles accesorios, si los hay, se incluyen con el estuche.",
      "status": "supplier_declared"
    },
    {
      "id": "claim:reposa-puros-plegable-description",
      "type": "Claim",
      "name": "Este soporte de acero inoxidable permite apoyar el puro mientras haces una pausa. Su diseño plegable en forma de X facilita guardarlo y llevarlo contigo. Está disponible en dos acabados: plata y negro.",
      "status": "supplier_declared"
    }
  ],
